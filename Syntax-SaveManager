-- Syntax UI SaveManager v2
-- Safe JSON persistence with optional automatic loading.

local SaveManager = {Folder = "SyntaxUI", Config = "default", AutoLoad = false, Library = nil, Ignore = {}}
SaveManager.__index = SaveManager

local function safe(fn, fallback)
    local ok, result = pcall(fn)
    if ok then return result end
    return fallback
end
local function env(name)
    local g = (getgenv and getgenv()) or _G
    return g and g[name]
end
local function available(name) return type(env(name)) == "function" end

function SaveManager:SetLibrary(library) self.Library = library; return self end
function SaveManager:SetFolder(folder) if type(folder) == "string" and folder ~= "" then self.Folder = folder end; return self end
function SaveManager:SetConfig(name) if type(name) == "string" and name ~= "" then self.Config = name end; return self end
function SaveManager:SetAutoLoad(enabled) self.AutoLoad = enabled == true; return self end
function SaveManager:IgnoreThemeSettings() self.Ignore.Theme = true; return self end
function SaveManager:_path(name) return self.Folder .. "/" .. tostring(name or self.Config):gsub("[^%w_%-]", "_") .. ".json" end
function SaveManager:_ensureFolder()
    if not available("makefolder") or not available("isfolder") then return true end
    if not safe(function() return env("isfolder")(self.Folder) end, false) then return safe(function() env("makefolder")(self.Folder); return true end, false) end
    return true
end
function SaveManager:Save(name)
    if not self.Library or not available("writefile") then return false, "writefile unavailable" end
    self:SetConfig(name or self.Config); self:_ensureFolder()
    local data = safe(function() return self.Library:GetConfigData(self.Ignore) end, nil)
    local encoded = data and safe(function() return game:GetService("HttpService"):JSONEncode(data) end, nil)
    if not encoded then return false, "serialization failed" end
    local ok = safe(function() env("writefile")(self:_path(), encoded); return true end, false)
    self.Library:Notify({Content = ok and "Saved: " .. self.Config or "Save failed", Duration = 2})
    return ok
end
function SaveManager:Load(name)
    if not self.Library or not available("readfile") or not available("isfile") then return false, "readfile/isfile unavailable" end
    self:SetConfig(name or self.Config); local path = self:_path()
    if not safe(function() return env("isfile")(path) end, false) then return false, "config not found" end
    local raw = safe(function() return env("readfile")(path) end, nil)
    local data = raw and safe(function() return game:GetService("HttpService"):JSONDecode(raw) end, nil)
    if not data then return false, "invalid config" end
    local ok = safe(function() return self.Library:SetConfigData(data, self.Ignore) end, false)
    self.Library:Notify({Content = ok and "Loaded: " .. self.Config or "Load failed", Duration = 2})
    return ok
end
function SaveManager:Delete(name)
    if not available("delfile") or not available("isfile") then return false, "delfile/isfile unavailable" end
    self:SetConfig(name or self.Config); local path = self:_path()
    if not safe(function() return env("isfile")(path) end, false) then return false, "config not found" end
    local ok = safe(function() env("delfile")(path); return true end, false)
    if self.Library then self.Library:Notify({Content = ok and "Deleted: " .. self.Config or "Delete failed", Duration = 2}) end
    return ok
end
function SaveManager:BuildConfigSection(tab)
    local section = tab:AddSection("PREFERENCES")
    local nameBox = section:AddTextbox({Key = "configName", Title = "Config name", Placeholder = "default", Default = self.Config}, function(value) self:SetConfig(value) end)
    section:AddToggle({Key = "autoLoad", Title = "Auto load config", Default = self.AutoLoad}, function(value) self:SetAutoLoad(value) end)
    section:AddButton({Title = "Save current config", Callback = function() self:Save(nameBox.Value()) end})
    section:AddButton({Title = "Load selected config", Callback = function() self:Load(nameBox.Value()) end})
    section:AddButton({Title = "Delete selected config", Callback = function() self:Delete(nameBox.Value()) end})
    if self.AutoLoad then task.defer(function() self:Load(self.Config) end) end
    return section
end
return SaveManager
    local section = tab:AddSection("CONFIGURATION")
    section:AddTextbox({Title = "Config name", Placeholder = "default", Default = "default"})
    section:AddButton({Title = "Save current configuration", Callback = function() self:Save("default") end})
    section:AddButton({Title = "Load configuration", Callback = function() self:Load("default") end})
    section:AddButton({Title = "Delete configuration", Callback = function() self:Delete("default") end})
    return section
end

function SaveManager:_path(name)
    return self.Folder .. "/" .. tostring(name):gsub("[^%w_%-]", "_") .. ".json"
end

function SaveManager:_ensureFolder()
    if not can("makefolder") or not can("isfolder") then return true end
    local isfolder = fn("isfolder")
    if not safe(function() return isfolder(self.Folder) end, false) then
        return safe(function() fn("makefolder")(self.Folder) return true end, false)
    end
    return true
end

function SaveManager:Save(name)
    if not self.Library or not can("writefile") then return false, "writefile unavailable" end
    self:_ensureFolder()
    local HttpService = game:GetService("HttpService")
    local data = safe(function() return self.Library:GetConfigData(self.Ignore) end, nil)
    if not data then return false, "could not serialize controls" end
    local encoded = safe(function() return HttpService:JSONEncode(data) end, nil)
    if not encoded then return false, "could not encode configuration" end
    local ok = safe(function() fn("writefile")(self:_path(name or "default"), encoded) return true end, false)
    if self.Library then self.Library:Notify({Content = ok and "Configuration saved" or "Save failed", Duration = 2}) end
    return ok, ok and nil or "write failed"
end

function SaveManager:Load(name)
    if not self.Library or not can("readfile") or not can("isfile") then return false, "readfile/isfile unavailable" end
    local path = self:_path(name or "default")
    if not safe(function() return fn("isfile")(path) end, false) then return false, "configuration not found" end
    local encoded = safe(function() return fn("readfile")(path) end, nil)
    local data = encoded and safe(function() return game:GetService("HttpService"):JSONDecode(encoded) end, nil)
    if not data then return false, "invalid configuration" end
    local ok = safe(function() self.Library:SetConfigData(data, self.Ignore) return true end, false)
    if self.Library then self.Library:Notify({Content = ok and "Configuration loaded" or "Load failed", Duration = 2}) end
    return ok
end

function SaveManager:Delete(name)
    if not can("delfile") or not can("isfile") then return false, "delfile/isfile unavailable" end
    local path = self:_path(name or "default")
    if not safe(function() return fn("isfile")(path) end, false) then return false, "configuration not found" end
    local ok = safe(function() fn("delfile")(path) return true end, false)
    if self.Library then self.Library:Notify({Content = ok and "Configuration deleted" or "Delete failed", Duration = 2}) end
    return ok
end

return SaveManager
