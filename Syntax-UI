		Text = "", AutoButtonColor = false, BackgroundTransparency = 1,
		Position = UDim2.fromOffset(26, 0), Size = UDim2.fromOffset(W - 26 - rightPad, Hh),
	}, body)
	local sw
	local nameX = 8
	if cfg.ShowSwitch then
		sw = MakeSwitch(tbtn, 42, 24)
		sw.track.AnchorPoint = Vector2.new(0, 0.5); sw.track.Position = UDim2.new(0, 2, 0.5, 0)
		nameX = 54
	end
	local nameLbl = Label(tbtn, tostring(cfg.Name or ""), 12, "text", FB)
	nameLbl.Position = UDim2.fromOffset(nameX, 8); nameLbl.Size = UDim2.new(1, -nameX, 0, 16); nameLbl.TextTruncate = Enum.TextTruncate.AtEnd
	local stateLbl = Label(tbtn, tostring(cfg.SubText or ""), 10, "dim", FM)
	stateLbl.Position = UDim2.fromOffset(nameX, 24); stateLbl.Size = UDim2.new(1, -nameX, 0, 14)
	tbtn.MouseButton1Click:Connect(function() Safe(cfg.OnToggle or cfg.OnExpand) end)

	if cfg.OnExpand then
		local eb = New("TextButton", {
			Text = "", AutoButtonColor = false, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -9, 0.5, 0),
			Size = UDim2.fromOffset(30, 30), BorderSizePixel = 0,
		}, body)
		Themed(eb, "BackgroundColor3", "panel"); Round(eb, 15); Juice(eb, "panel", "panel2")
		local ic = New("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(12, 11), BackgroundTransparency = 1 }, eb)
		Round(ic, 3); Outline(ic, "text", 1.6, 0)
		local bar = New("Frame", { Position = UDim2.fromOffset(0, 2), Size = UDim2.new(1, 0, 0, 2), BorderSizePixel = 0 }, ic)
		Themed(bar, "BackgroundColor3", "text")
		eb.MouseButton1Click:Connect(function() Safe(cfg.OnExpand) end)
	end

	MakeDraggable(grip, shell)

	pill.Shell = shell
	function pill:SetState(on)
		on = on and true or false
		if self.on == on then return end
		self.on = on
		if sw then sw.set(on) end
		stateLbl.Text = on and "ON" or "OFF"
	end
	function pill:SetName(s) nameLbl.Text = tostring(s) end
	function pill:SetSub(s) stateLbl.Text = tostring(s) end
	function pill:SetScale(v)
		baseScale = tonumber(v) or 1
		if self.Visible then Tw(sc, 0.15, { Scale = baseScale }) end
	end
	function pill:Show()
		self.Visible = true
		shell.Visible = true
		sc.Scale = 0.5 * baseScale
		Tw(sc, 0.55, { Scale = baseScale }, Enum.EasingStyle.Back)
		Tw(body, 0.35, { GroupTransparency = 0 })
		Tw(st, 0.35, { Transparency = 0 })
	end
	function pill:Hide()
		self.Visible = false
		Tw(sc, 0.3, { Scale = 0.6 * baseScale })
		Tw(body, 0.25, { GroupTransparency = 1 })
		Tw(st, 0.25, { Transparency = 1 })
		task.delay(0.32, function() if not pill.Visible then shell.Visible = false end end)
	end
	function pill:Destroy() shell:Destroy() end
	return pill
end

-- ===================== intro: bokeh loader + use-at-your-own-risk =====================
function Library:_RunIntro(cfg, onDone)
	cfg = cfg or {}
	local gui = self:_Gui()
	local vp = self:_Viewport()
	local rng = Random.new()
	local fade, fadeGoal = 0, 1
	local progShown, progGoal = 0, 0
	local started = false
	local lib = self

	local blur
	pcall(function()
		blur = Instance.new("BlurEffect")
		blur.Name = "SyntaxIntroBlur"; blur.Size = 0; blur.Parent = Lighting
