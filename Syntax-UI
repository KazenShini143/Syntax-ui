function Elements:AddToggle(idx, cfg)
	cfg = cfg or {}
	local hasDesc = cfg.Description and cfg.Description ~= ""
	local card = Card(self.Container, hasDesc and 54 or 42)
	local hit = New("TextButton", { Text = "", AutoButtonColor = false, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) }, card)
	Header(card, cfg, 66)
	local sw = MakeSwitch(card, 50, 26)
	sw.track.AnchorPoint = Vector2.new(1, 0.5); sw.track.Position = UDim2.new(1, -12, 0.5, 0)
	local T = BaseOption("Toggle", idx, cfg)
	T.Value = false
	function T:SetValue(v, silent)
		v = v and true or false
		local changed = (self.Value ~= v)
		self.Value = v
		sw.set(v)
		if changed and not silent then Fire(self, v) end
	end
	hit.MouseButton1Click:Connect(function() T:SetValue(not T.Value) end)
	if cfg.Default then T:SetValue(true) end
	return T
end

function Elements:AddSlider(idx, cfg)
	cfg = cfg or {}
	local mn, mx = cfg.Min or 0, cfg.Max or 100
	local rounding = cfg.Rounding or 0
	local card = Card(self.Container, 62)
	local t = Label(card, tostring(cfg.Title or ""), 11, "dim", FB)
	t.Position = UDim2.fromOffset(12, 6); t.Size = UDim2.new(0.65, 0, 0, 16)
	t.TextTruncate = Enum.TextTruncate.AtEnd
	local vl = Label(card, "", 12, "hi", FB, Enum.TextXAlignment.Right)
	vl.Position = UDim2.new(0.65, 0, 0, 5); vl.Size = UDim2.new(0.35, -14, 0, 18)
	local hit = New("Frame", { Position = UDim2.fromOffset(14, 26), Size = UDim2.new(1, -28, 0, 28), BackgroundTransparency = 1 }, card)
	local track = New("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.new(1, 0, 0, 6), BorderSizePixel = 0 }, hit)
	Themed(track, "BackgroundColor3", "bg"); Round(track, 3)
	local fill = New("Frame", { Size = UDim2.new(0, 0, 1, 0), BorderSizePixel = 0 }, track)
	Themed(fill, "BackgroundColor3", "hi"); Round(fill, 3)
	local knob = New("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.fromOffset(16, 16), BorderSizePixel = 0, ZIndex = 3 }, track)
	Themed(knob, "BackgroundColor3", "knob"); Round(knob, 16); Outline(knob, "hi", 2, 0.1)

	local S = BaseOption("Slider", idx, cfg)
	S.Value = mn
	function S:SetValue(v, silent)
		v = math.clamp(tonumber(v) or mn, mn, mx)
		local m = 10 ^ rounding
		v = math.floor(v * m + 0.5) / m
		local changed = (self.Value ~= v)
		self.Value = v
		vl.Text = (rounding > 0) and string.format("%." .. rounding .. "f", v) or tostring(v)
		local a = (mx > mn) and (v - mn) / (mx - mn) or 0
		Tw(fill, 0.1, { Size = UDim2.new(a, 0, 1, 0) }, Enum.EasingStyle.Quad)
		Tw(knob, 0.1, { Position = UDim2.new(a, 0, 0.5, 0) }, Enum.EasingStyle.Quad)
		if changed and not silent then Fire(self, v) end
	end
	local sliding = false
	local function fromX(x)
		local w = math.max(1, track.AbsoluteSize.X)
		local a = math.clamp((x - track.AbsolutePosition.X) / w, 0, 1)
		S:SetValue(mn + a * (mx - mn))
	end
	hit.InputBegan:Connect(function(i) if IsPress(i) then sliding = true; fromX(i.Position.X) end end)
	Bind(UserInputService.InputChanged, function(i) if sliding and IsMove(i) then fromX(i.Position.X) end end)
	Bind(UserInputService.InputEnded, function(i) if IsPress(i) then sliding = false end end)
	S:SetValue(cfg.Default or mn, true)
	return S
end

function Elements:AddInput(idx, cfg)
	cfg = cfg or {}
	local card = Card(self.Container, 52)
	local t = Label(card, tostring(cfg.Title or ""), 11, "dim", FB)
	t.Position = UDim2.fromOffset(12, 6); t.Size = UDim2.new(1, -24, 0, 16)
	local box = New("TextBox", {
		Text = "", PlaceholderText = cfg.Placeholder or "...", TextSize = 13, Font = FM, ClearTextOnFocus = false,
		BorderSizePixel = 0, Position = UDim2.fromOffset(8, 24), Size = UDim2.new(1, -16, 0, 22), TextXAlignment = Enum.TextXAlignment.Left,
	}, card)
	Themed(box, "BackgroundColor3", "bg"); Themed(box, "TextColor3", "text"); Themed(box, "PlaceholderColor3", "dim")
	Round(box, 6); Outline(box, "accent", 1, 0.5)
	New("UIPadding", { PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6) }, box)

	local I = BaseOption("Input", idx, cfg)
	local suppress = false
	I.Value = tostring(cfg.Default or "")
	box.Text = I.Value
	function I:SetValue(v, silent)
		v = tostring(v == nil and "" or v)
		local changed = (self.Value ~= v)
		self.Value = v
		suppress = true; box.Text = v; suppress = false
		if changed and not silent then Fire(self, v) end
	end
	box:GetPropertyChangedSignal("Text"):Connect(function()
		if suppress then return end
		if cfg.Numeric then
			local f = box.Text:gsub("[^%d%.%-]", "")
			if f ~= box.Text then box.Text = f return end
		end
		I.Value = box.Text
		if not cfg.Finished then Fire(I, I.Value) end
	end)
	box.FocusLost:Connect(function()
		I.Value = box.Text
		if cfg.Finished then Fire(I, I.Value) end
	end)
	return I
end

function Elements:AddDropdown(idx, cfg)
	cfg = cfg or {}
	local hasDesc = cfg.Description and cfg.Description ~= ""
	local baseH = hasDesc and 54 or 42
	local card = Card(self.Container, baseH)
	card.ClipsDescendants = true
	local hit = New("TextButton", { Text = "", AutoButtonColor = false, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, baseH) }, card)
	Header(card, cfg, 150)
	local vl = Label(card, "", 12, "hi", FB, Enum.TextXAlignment.Right)
	vl.Size = UDim2.new(0, 130, 0, baseH); vl.Position = UDim2.new(1, -142, 0, 0); vl.TextTruncate = Enum.TextTruncate.AtEnd
	local list = New("ScrollingFrame", {
		Position = UDim2.fromOffset(8, baseH), Size = UDim2.new(1, -16, 0, 0), BackgroundTransparency = 1, BorderSizePixel = 0,
		ScrollBarThickness = 3, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
	}, card)
	New("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 3) }, list)

	local D = BaseOption("Dropdown", idx, cfg)
	D.Multi = cfg.Multi and true or false
	D.Values = cfg.Values or {}
	D.Value = D.Multi and {} or nil

	local items = {}
	local open = false

	local function isSel(v)
		if D.Multi then return D.Value[v] == true end
		return D.Value == v
	end
	local function display()
		if D.Multi then
			local t = {}
			for _, v in ipairs(D.Values) do if D.Value[v] then t[#t + 1] = tostring(v) end end
			vl.Text = (#t > 0) and table.concat(t, ", ") or "None"
		else
			vl.Text = (D.Value ~= nil and D.Value ~= "") and tostring(D.Value) or "None"
		end
	end
	local function paint()
		for v, b in pairs(items) do
			b.BackgroundColor3 = isSel(v) and Palette.accent or Palette.panel2
		end
	end
	local function listH() return math.min(#D.Values * 29, 145) end
	local function resize()
		list.Size = UDim2.new(1, -16, 0, listH())
		Tw(card, 0.2, { Size = UDim2.new(1, 0, 0, open and (baseH + listH() + 8) or baseH) })
	end
	local function pick(v)
		if D.Multi then
			D.Value[v] = (not D.Value[v]) or nil
		else
			D.Value = v
			open = false
		end
		display(); paint(); resize()
		Fire(D, D.Value)
	end
	local function rebuild()
		for _, c in ipairs(list:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
		items = {}
		for i, v in ipairs(D.Values) do
			local b = New("TextButton", { Text = "", AutoButtonColor = false, Size = UDim2.new(1, 0, 0, 26), BorderSizePixel = 0, LayoutOrder = i }, list)
			Round(b, 6)
			local l = Label(b, tostring(v), 12, "text", FM)
			l.Size = UDim2.new(1, -12, 1, 0); l.Position = UDim2.fromOffset(8, 0)
			items[v] = b
			b.MouseButton1Click:Connect(function() pick(v) end)
		end
		paint()
	end

	function D:SetValue(v, silent)
		if self.Multi then
			local nv = {}
			if type(v) == "table" then
				for k, on in pairs(v) do
					if type(k) == "number" then nv[on] = true elseif on then nv[k] = true end
				end
			end
			self.Value = nv
		else
			if type(v) == "number" and self.Values[v] ~= nil then v = self.Values[v] end
			self.Value = v
		end
		display(); paint()
		if not silent then Fire(self, self.Value) end
	end
	function D:SetValues(vals)
		self.Values = vals or {}
		rebuild(); display(); resize()
	end

	if cfg.Default ~= nil then
		if D.Multi then
			D:SetValue(cfg.Default, true)
		else
			local dv = cfg.Default
			if type(dv) == "number" and D.Values[dv] ~= nil then dv = D.Values[dv] end
			D.Value = dv
		end
	end
	rebuild(); display()
	Refreshers[#Refreshers + 1] = function() if card.Parent then paint() end end
	hit.MouseButton1Click:Connect(function() open = not open; resize() end)
	return D
end

function Elements:AddKeybind(idx, cfg)
	cfg = cfg or {}
	local card = Card(self.Container, 42)
	Header(card, cfg, 110)
	local b = New("TextButton", {
		Text = "", AutoButtonColor = false, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(92, 26), BorderSizePixel = 0,
	}, card)
	Themed(b, "BackgroundColor3", "bg"); Round(b, 6); Outline(b, "accent", 1, 0.5)
	local txt = Label(b, "", 12, "hi", FB, Enum.TextXAlignment.Center)
	txt.Size = UDim2.fromScale(1, 1)

	local K = BaseOption("Keybind", idx, cfg)
	local function nameOf(v)
		if typeof(v) == "EnumItem" then return v.Name end
		if v == nil or v == "" then return "None" end
		return tostring(v)
	end
	K.Value = nameOf(cfg.Default)
	txt.Text = K.Value
	local binding = false
	function K:SetValue(v, silent)
		local name = nameOf(v)
		local changed = (self.Value ~= name)
		self.Value = name
		txt.Text = name
		if changed and not silent then
			local ok, kc = pcall(function() return Enum.KeyCode[name] end)
			if ok and kc then Safe(cfg.ChangedCallback, kc) end
			for _, fn in ipairs(self._changed) do Safe(fn, name) end
		end
	end
	b.MouseButton1Click:Connect(function() binding = true; txt.Text = "..." end)
	Bind(UserInputService.InputBegan, function(i, gp)
		if i.UserInputType ~= Enum.UserInputType.Keyboard then return end
		if binding then
			binding = false
			K:SetValue(i.KeyCode)
			return
		end
		if not gp and i.KeyCode.Name == K.Value then Safe(cfg.Callback, true) end
	end)
	return K
end

-- ===================== window =====================
local Window = {}
Window.__index = Window

local function MakeDraggable(handle, target, onTap)
	local dragging, start, orig, moved = false, nil, nil, 0
	handle.InputBegan:Connect(function(i)
		if IsPress(i) then
			dragging = true; moved = 0; start = i.Position; orig = target.Position
			local c
			c = i.Changed:Connect(function()
				if i.UserInputState == Enum.UserInputState.End then
					dragging = false
					c:Disconnect()
					if onTap and moved < 6 then onTap() end
				end
			end)
		end
	end)
	Bind(UserInputService.InputChanged, function(i)
		if dragging and IsMove(i) then
			local d = i.Position - start
			moved = math.max(moved, d.Magnitude)
			target.Position = UDim2.new(orig.X.Scale, orig.X.Offset + d.X, orig.Y.Scale, orig.Y.Offset + d.Y)
		end
	end)
end

function Library:CreateWindow(cfg)
	cfg = cfg or {}
	local gui = self:_Gui()
	local vp = self:_Viewport()
	local W = cfg.Width or 580
	local H = cfg.Height or 400
	if typeof(cfg.Size) == "UDim2" then W, H = cfg.Size.X.Offset, cfg.Size.Y.Offset end
	W = math.max(300, math.min(W, vp.X - 24))
	H = math.max(220, math.min(H, vp.Y - 24))

	local win = setmetatable({ Tabs = {}, Library = self }, Window)

	local main = New("Frame", {
		Name = "Main", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(W, H), BorderSizePixel = 0, ClipsDescendants = true,
	}, gui)
	Themed(main, "BackgroundColor3", "bg"); Round(main, 10); Outline(main, "accent", 1.5, 0.2)
	local scale = New("UIScale", { Scale = 1 }, main)
	win.Main, win.Scale = main, scale

	local top = New("Frame", { Size = UDim2.new(1, 0, 0, 38), BackgroundTransparency = 1 }, main)
	local title = tostring(cfg.Title or "Syntax")
	local sub = cfg.SubTitle or cfg.Subtitle
	if sub and sub ~= "" then title = title .. "  |  " .. tostring(sub) end
	local tl = Label(top, title, 14, "text", FB)
	tl.Position = UDim2.fromOffset(12, 0); tl.Size = UDim2.new(1, -56, 1, 0)
	tl.TextTruncate = Enum.TextTruncate.AtEnd

	local minBtn = New("TextButton", {
		Text = "-", Font = FB, TextSize = 18, AutoButtonColor = false, AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(28, 28), BorderSizePixel = 0,
	}, top)
	Themed(minBtn, "BackgroundColor3", "panel"); Themed(minBtn, "TextColor3", "text"); Round(minBtn, 8)
	Juice(minBtn, "panel", "panel2")

	local sbW = math.floor(math.min(140, W * 0.28))
	local sidebar = New("ScrollingFrame", {
		Position = UDim2.fromOffset(8, 42), Size = UDim2.new(0, sbW, 1, -50), BackgroundTransparency = 1, BorderSizePixel = 0,
		ScrollBarThickness = 0, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
	}, main)
	New("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 4) }, sidebar)

	local content = New("Frame", {
		Position = UDim2.fromOffset(sbW + 16, 42), Size = UDim2.new(1, -(sbW + 24), 1, -50), BackgroundTransparency = 1, ClipsDescendants = true,
	}, main)

	local mini = New("TextButton", {
		Text = "S", Font = FB, TextSize = 18, AutoButtonColor = false, Size = UDim2.fromOffset(44, 44),
		Position = UDim2.fromOffset(20, 80), BorderSizePixel = 0, Visible = false, ZIndex = 50,
	}, gui)
	Themed(mini, "BackgroundColor3", "accent"); Themed(mini, "TextColor3", "text"); Round(mini, 12); Outline(mini, "hi", 1.5, 0.2)
	win.Mini = mini

	function win:Minimize() main.Visible = false; mini.Visible = true; self.Minimized = true end
	function win:Restore() main.Visible = true; mini.Visible = false; self.Minimized = false end
	function win:Toggle() if self.Minimized then self:Restore() else self:Minimize() end end
	function win:SetScale(v) scale.Scale = math.clamp(tonumber(v) or 1, 0.5, 1.5) end
	function win:SetMiniToggle(on) if self.Minimized then mini.Visible = on and true or false end end
	function win:MiniNotify(c) Library:Notify(c) end
	function win:Destroy() Library:Destroy() end

	minBtn.MouseButton1Click:Connect(function() win:Minimize() end)
	MakeDraggable(top, main)
	MakeDraggable(mini, mini, function() win:Restore() end)
	Bind(UserInputService.InputBegan, function(i, gp)
		if gp then return end
		if i.UserInputType == Enum.UserInputType.Keyboard and i.KeyCode == Library.MinimizeKeybind then win:Toggle() end
	end)

	local function paintTabs()
		for _, t in ipairs(win.Tabs) do
			local active = (t == win.Current)
			t.Btn.BackgroundColor3 = active and Palette.accent or Palette.panel
			t.Btn.BackgroundTransparency = active and 0 or 0.35
		end
	end
	Refreshers[#Refreshers + 1] = function() if main.Parent then paintTabs() end end

	function win:SelectTab(t)
		if type(t) == "number" then t = self.Tabs[t] end
		if not t then return end
		self.Current = t
		for _, o in ipairs(self.Tabs) do o.Page.Visible = (o == t) end
		paintTabs()
	end

	function win:AddTab(c)
		if type(c) == "string" then c = { Title = c } end
		c = c or {}
		local btn = New("TextButton", {
			Text = "", AutoButtonColor = false, Size = UDim2.new(1, 0, 0, 32), BorderSizePixel = 0, LayoutOrder = #self.Tabs + 1,
		}, sidebar)
		Themed(btn, "BackgroundColor3", "panel"); Round(btn, 8)
		local bl = Label(btn, tostring(c.Title or "Tab"), 12, "text", FB)
		bl.Position = UDim2.fromOffset(10, 0); bl.Size = UDim2.new(1, -14, 1, 0); bl.TextTruncate = Enum.TextTruncate.AtEnd

		local page = New("ScrollingFrame", {
			Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3,
			CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, Visible = false,
		}, content)
		page.ScrollBarImageColor3 = Palette.accent
		New("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6) }, page)
		New("UIPadding", { PaddingRight = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6) }, page)

		local tab = setmetatable({ Title = c.Title, Window = self, Container = page, Page = page, Btn = btn }, Elements)
		self.Tabs[#self.Tabs + 1] = tab
		btn.MouseButton1Click:Connect(function() self:SelectTab(tab) end)
		if #self.Tabs == 1 then self:SelectTab(tab) else paintTabs() end
		return tab
	end

	self.Windows[#self.Windows + 1] = win
	return win
end

return Library
