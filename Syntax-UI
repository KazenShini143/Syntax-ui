-- Syntax UI Core Library
-- Fluent-inspired, modular Roblox Luau UI framework.

local Syntax = {}
Syntax.__index = Syntax

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local CoreGui = game:GetService("CoreGui")

Syntax.Themes = {
    Dark = {
        Background = Color3.fromRGB(16, 16, 24), Surface = Color3.fromRGB(24, 24, 36),
        SurfaceAlt = Color3.fromRGB(31, 31, 47), Text = Color3.fromRGB(245, 245, 255),
        Muted = Color3.fromRGB(165, 165, 190), Border = Color3.fromRGB(62, 62, 86),
        Primary = Color3.fromRGB(170, 0, 255), Secondary = Color3.fromRGB(0, 162, 255),
        Success = Color3.fromRGB(0, 255, 150), Danger = Color3.fromRGB(255, 90, 120)
    }
}

local function safe(fn, fallback)
    local ok, result = pcall(fn)
    if ok then return result end
    return fallback
end

local function tween(obj, duration, props, style, direction)
    safe(function()
        TweenService:Create(obj, TweenInfo.new(duration, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out), props):Play()
    end)
end

local function corner(parent, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 8)
    c.Parent = parent
    return c
end

local function stroke(parent, color, transparency)
    local s = Instance.new("UIStroke")
    s.Color = color
    s.Transparency = transparency or 0
    s.Thickness = 1
    s.Parent = parent
    return s
end

local function gradient(parent, a, b, rotation)
    local g = Instance.new("UIGradient")
    g.Color = ColorSequence.new(a, b or a)
    g.Rotation = rotation or 0
    g.Parent = parent
    return g
end

local function addFeedback(button, theme)
    local scale = Instance.new("UIScale")
    scale.Parent = button
    button.AutoButtonColor = false
    button.MouseEnter:Connect(function()
        tween(scale, .12, {Scale = 1.025})
        tween(button, .12, {BackgroundTransparency = .08})
    end)
    button.MouseLeave:Connect(function()
        tween(scale, .12, {Scale = 1})
        tween(button, .12, {BackgroundTransparency = 0})
    end)
    button.MouseButton1Down:Connect(function() tween(scale, .07, {Scale = .965}) end)
    button.MouseButton1Up:Connect(function() tween(scale, .1, {Scale = 1.025}) end)
end

local function label(parent, text, height, color, size)
    local x = Instance.new("TextLabel")
    x.Size = UDim2.new(1, 0, 0, height or 24)
    x.BackgroundTransparency = 1
    x.Text = text or ""
    x.TextColor3 = color
    x.Font = Enum.Font.Gotham
    x.TextSize = size or 13
    x.TextXAlignment = Enum.TextXAlignment.Left
    x.TextWrapped = true
    x.Parent = parent
    return x
end

function Syntax:_refreshTheme()
    local t = self.Theme
    self.Main.BackgroundColor3 = t.Background
    self.Nav.BackgroundColor3 = t.Surface
    self.Border.Color = t.Secondary
    for _, tab in ipairs(self.Tabs) do
        tab.NavButton.TextColor3 = t.Muted
        tab.Page.BackgroundColor3 = t.Background
        for _, section in ipairs(tab.Sections) do
            section.Frame.BackgroundColor3 = t.Surface
            section.Title.TextColor3 = t.Success
        end
    end
end

function Syntax:SetTheme(theme)
    if type(theme) == "table" then
        for key, value in pairs(theme) do self.Theme[key] = value end
        self:_refreshTheme()
    end
    return self
end

function Syntax:Notify(options)
    options = options or {}
    local holder = self.NotificationHolder
    local item = Instance.new("TextLabel")
    item.Size = UDim2.new(1, 0, 0, 38)
    item.BackgroundColor3 = self.Theme.SurfaceAlt
    item.TextColor3 = self.Theme.Text
    item.Font = Enum.Font.Gotham
    item.TextSize = 13
    item.Text = tostring(options.Content or options.Title or "Notification")
    item.TextWrapped = true
    item.BackgroundTransparency = 1
    item.Parent = holder
    corner(item, 8)
    stroke(item, self.Theme.Secondary, .2)
    tween(item, .18, {BackgroundTransparency = 0})
    task.delay(tonumber(options.Duration) or 3, function()
        tween(item, .18, {BackgroundTransparency = 1, TextTransparency = 1})
        task.wait(.2)
        safe(function() item:Destroy() end)
    end)
end

function Syntax:CreateWindow(options)
    options = options or {}
