function Syntax:SelectTab(activeTab)
    for _, tab in ipairs(self.Tabs) do
        local active = tab == activeTab
        tab.Page.Visible = active
        play(tab.NavButton, .18, {BackgroundColor3 = active and self.Theme.Primary or self.Theme.SurfaceAlt, TextColor3 = active and self.Theme.Text or self.Theme.Muted, BackgroundTransparency = active and 0 or .15}, EASE, OUT)
    end
    activeTab.Page.Position = UDim2.fromOffset(18, 36)
    play(activeTab.Page, .22, {Position = UDim2.fromOffset(12, 36)}, EASE, OUT)
end

