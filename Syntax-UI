local Registry, Refreshers, Conns = {}, {}, {}
local FB, FM = Enum.Font.GothamBold, Enum.Font.GothamMedium

local function Bind(sig, fn)
    local c = sig:Connect(fn)
    Conns[#Conns + 1] = c
    return c
end
local function Trace(e) return debug.traceback(tostring(e), 2) end
local function Safe(fn, ...)
    if type(fn) ~= "function" then return end
    local ok, err = xpcall(fn, Trace, ...)
    if not ok then warn(TAG, "callback error:", err) end
end

-- ======================================================================
--  BASIC HELPERS
-- ======================================================================
local function New(class, props, parent)
    local o = Instance.new(class)
    if props then for k, v in pairs(props) do o[k] = v end end
    if parent then o.Parent = parent end
    return o
end
local function Themed(obj, prop, key)
    Registry[#Registry + 1] = { obj = obj, prop = prop, key = key }
    obj[prop] = Palette[key]
    return obj
end
local function Round(p, r) return New("UICorner", { CornerRadius = UDim.new(0, r) }, p) end
local function Outline(p, key, th, tr)
    local s = New("UIStroke", { Thickness = th, Transparency = tr or 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, p)
    Themed(s, "Color", key)
    return s
end
local function Tw(o, t, props, es, ed)
    local tw = TweenService:Create(o, TweenInfo.new(t, es or Enum.EasingStyle.Quint, ed or Enum.EasingDirection.Out), props)
    tw:Play()
    return tw
end
local function Label(parent, text, size, key, font, xa)
    local l = New("TextLabel", {
        Text = text, TextSize = size, Font = font or FM, BackgroundTransparency = 1, BorderSizePixel = 0,
        TextXAlignment = xa or Enum.TextXAlignment.Left,
    }, parent)
    Themed(l, "TextColor3", key or "text")
    return l
end
local function Ease(dt, k) return 1 - math.exp(-dt * k) end
local function R(n) return math.floor(n + 0.5) end

-- hover / press feel
local function Juice(btn, baseKey, hoverKey)
    local sc = New("UIScale", { Scale = 1 }, btn)
    btn.MouseEnter:Connect(function() Tw(btn, 0.12, { BackgroundColor3 = Palette[hoverKey] }) end)
    btn.MouseLeave:Connect(function()
        Tw(btn, 0.18, { BackgroundColor3 = Palette[baseKey] })
        Tw(sc, 0.18, { Scale = 1 })
    end)
    btn.MouseButton1Down:Connect(function() Tw(sc, 0.07, { Scale = 0.96 }) end)
    btn.MouseButton1Up:Connect(function() Tw(sc, 0.25, { Scale = 1 }, Enum.EasingStyle.Back) end)
end

local function IsPress(i)
    return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch
end

-- ======================================================================
--  THEME API
-- ======================================================================
function Library:SetTheme(name)
    local t = self.Themes[name]
    if not t then warn(TAG, "unknown theme:", name) return end
    self.ThemeName = name
    for k, v in pairs(t) do Palette[k] = v end
    local keep = {}
    for _, e in ipairs(Registry) do
        if e.obj and e.obj.Parent then
            Tw(e.obj, 0.25, { [e.prop] = Palette[e.key] })
            keep[#keep + 1] = e
        end
    end
    Registry = keep
    for _, fn in ipairs(Refreshers) do Safe(fn) end
end

-- ======================================================================
--  GUI ROOT
-- ======================================================================
function Library:_Gui()
    if self.Gui and self.Gui.Parent then return self.Gui end
    local gui = New("ScreenGui", {
        Name = "SyntaxUI", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        IgnoreGuiInset = true, DisplayOrder = 999,
    })
    local ok = false
    if type(gethui) == "function" then ok = pcall(function() gui.Parent = gethui() end) end
    if not ok or not gui.Parent then ok = pcall(function() gui.Parent = CoreGui end) end
    if not ok or not gui.Parent then gui.Parent = LocalPlayer:WaitForChild("PlayerGui") end
    local w = 0
    while gui.AbsoluteSize.X < 50 and w < 1 do w = w + task.wait() end
    self.Gui = gui
    return gui
end
function Library:_Viewport()
    local v = self.Gui and self.Gui.AbsoluteSize or Vector2.new(0, 0)
    if v.X < 50 or v.Y < 50 then
        local cam = workspace.CurrentCamera
        v = cam and cam.ViewportSize or Vector2.new(800, 600)
    end
    return v
end

