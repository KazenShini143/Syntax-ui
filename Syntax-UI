local EASE = Enum.EasingStyle.Quint
local OUT = Enum.EasingDirection.Out
local IN = Enum.EasingDirection.In

local function copy(source)
    local result = {}
    for key, value in pairs(source) do result[key] = value end
    return result
end

local function safe(callback, fallback)
    local ok, value = pcall(callback)
    if ok then return value end
    return fallback
end

local function play(instance, duration, properties, style, direction)
    if not instance then return end
    safe(function()
        TweenService:Create(instance, TweenInfo.new(duration, style or EASE, direction or OUT), properties):Play()
    end)
end

local function setStroke(stroke, color, transparency, thickness)
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.LineJoinMode = Enum.LineJoinMode.Round
    stroke.Color = color
    stroke.Transparency = transparency or 0
    stroke.Thickness = thickness or 1
    return stroke
end

local function addCorner(parent, radius)
    local object = Instance.new("UICorner")
    object.CornerRadius = UDim.new(0, radius or 5)
    object.Parent = parent
    return object
end

local function addStroke(parent, color, transparency, thickness)
    return setStroke(Instance.new("UIStroke", parent), color, transparency, thickness)
end

local function addGradient(parent, first, second, rotation)
    local object = Instance.new("UIGradient", parent)
    object.Color = ColorSequence.new(first, second or first)
    object.Rotation = rotation or 0
    return object
end

local function addPadding(parent, left, right, top, bottom)
    local object = Instance.new("UIPadding", parent)
    object.PaddingLeft = UDim.new(0, left or 0)
    object.PaddingRight = UDim.new(0, right or 0)
    object.PaddingTop = UDim.new(0, top or 0)
    object.PaddingBottom = UDim.new(0, bottom or 0)
    return object
end

local function label(parent, text, height, color, size, font)
    local object = Instance.new("TextLabel", parent)
    object.Size = UDim2.new(1, 0, 0, height or 20)
    object.BackgroundTransparency = 1
    object.Text = tostring(text or "")
    object.TextColor3 = color
    object.TextSize = size or 12
    object.Font = font or Enum.Font.Gotham
    object.TextXAlignment = Enum.TextXAlignment.Left
    object.TextYAlignment = Enum.TextYAlignment.Center
    object.TextWrapped = true
    addPadding(object, 2, 2, 0, 0)
    return object
end

local function animateButton(button, scaleTarget)
    local scale = Instance.new("UIScale", button)
    scale.Scale = 1
    button.AutoButtonColor = false
    button.MouseEnter:Connect(function()
        play(scale, .16, {Scale = scaleTarget or 1.018}, Enum.EasingStyle.Sine)
        play(button, .16, {BackgroundTransparency = .04}, Enum.EasingStyle.Sine)
    end)
    button.MouseLeave:Connect(function()
        play(scale, .18, {Scale = 1}, Enum.EasingStyle.Sine)
        play(button, .18, {BackgroundTransparency = 0}, Enum.EasingStyle.Sine)
    end)
    button.MouseButton1Down:Connect(function() play(scale, .08, {Scale = .965}, Enum.EasingStyle.Quint) end)
    button.MouseButton1Up:Connect(function() play(scale, .12, {Scale = scaleTarget or 1.018}, Enum.EasingStyle.Quint) end)
    return scale
end

local function roundedButton(parent, theme, text, color, height)
    local button = Instance.new("TextButton", parent)
    button.Size = UDim2.new(1, 0, 0, height or 30)
    button.BackgroundColor3 = color or theme.Primary
    button.BorderSizePixel = 0
    button.Text = text or "Button"
    button.TextColor3 = theme.Text
    button.TextSize = 11
    button.Font = Enum.Font.GothamBold
    button.TextXAlignment = Enum.TextXAlignment.Left
    addPadding(button, 11, 11, 0, 0)
    addCorner(button, 5)
    addGradient(button, color or theme.GradientA, theme.GradientB, 0)
    animateButton(button)
    return button
end

