end

local function feedback(button)
    local scale = Instance.new("UIScale", button)
    button.AutoButtonColor = false
    button.MouseEnter:Connect(function() tween(scale, .12, {Scale = 1.02}); tween(button, .12, {BackgroundTransparency = .05}) end)
    button.MouseLeave:Connect(function() tween(scale, .12, {Scale = 1}); tween(button, .12, {BackgroundTransparency = 0}) end)
    button.MouseButton1Down:Connect(function() tween(scale, .07, {Scale = .965}) end)
    button.MouseButton1Up:Connect(function() tween(scale, .1, {Scale = 1.02}) end)
end

function Syntax:_themeObject(obj, colors)
    local theme = self.Theme
    safe(function()
        if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then obj.TextColor3 = theme.Text end
        if obj:IsA("Frame") or obj:IsA("ScrollingFrame") then obj.BackgroundColor3 = colors or theme.Surface end
        local s = obj:FindFirstChildOfClass("UIStroke")
        if s then s.Color = theme.Border end
    end)
end

function Syntax:ApplyTheme(theme)
    if type(theme) == "string" then theme = Themes[theme] end
    if type(theme) ~= "table" then return self end
    self.ThemeName = self.ThemeName or "Custom"
    self.Theme = {}
    for k, v in pairs(theme) do self.Theme[k] = v end
    local t = self.Theme
    safe(function()
        self.Main.BackgroundColor3 = t.Background; self.Nav.BackgroundColor3 = t.Surface
        self.Content.BackgroundColor3 = t.Background; self.Border.Color = t.Secondary
        self.TopGlow.BackgroundColor3 = t.Primary
        local glow = self.TopGlow:FindFirstChildOfClass("UIGradient")
        if glow then glow.Color = ColorSequence.new(t.GradientA or t.Primary, t.GradientB or t.Secondary) end
        for _, tab in ipairs(self.Tabs) do
            tab.Page.BackgroundColor3 = t.Background
            tab.NavButton.TextColor3 = t.Muted
            for _, section in ipairs(tab.Sections) do
                section.Frame.BackgroundColor3 = t.Surface
                section.Title.TextColor3 = t.Success
            end
        end
    end)
    return self
end

function Syntax:SetTheme(theme)
    return self:ApplyTheme(theme)
end

function Syntax:SetThemeName(name)
    if Themes[name] then self.ThemeName = name; self:ApplyTheme(Themes[name]) end
    return self
end

function Syntax:Notify(options)
    options = options or {}
    local item = Instance.new("TextLabel")
    item.Size = UDim2.new(1, 0, 0, 34); item.BackgroundColor3 = self.Theme.SurfaceAlt
    item.BackgroundTransparency = 1; item.TextColor3 = self.Theme.Text; item.Font = Enum.Font.GothamMedium
    item.TextSize = 12; item.Text = tostring(options.Content or options.Title or "Notification")
    item.TextWrapped = true; item.Parent = self.NotificationHolder
    corner(item, 8); addStroke(item, self.Theme.Secondary, .25)
    tween(item, .18, {BackgroundTransparency = 0})
    task.delay(tonumber(options.Duration) or 3, function()
        tween(item, .18, {BackgroundTransparency = 1, TextTransparency = 1})
        task.wait(.2); safe(function() item:Destroy() end)
    end)
end

