	}
	local bokeh = {}
	for i = 1, 18 do
		local sz = rng:NextInteger(60, 240)
		local col = colors[rng:NextInteger(1, #colors)]
		local f = New("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(sz, sz), BackgroundColor3 = col,
			BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 2,
		}, layer)
		New("UICorner", { CornerRadius = UDim.new(1, 0) }, f)
		local s = New("UIStroke", { Color = col, Thickness = 1.5, Transparency = 1 }, f)
		bokeh[i] = {
			f = f, st = s, bx = rng:NextNumber(0.02, 0.98), by = rng:NextNumber(0.02, 0.98),
			ax = rng:NextNumber(12, 46), ay = rng:NextNumber(12, 46), sp = rng:NextNumber(0.15, 0.45),
			ph = rng:NextNumber(0, 6.28), base = rng:NextNumber(0.70, 0.84), sbase = rng:NextNumber(0.50, 0.72),
		}
	end

	-- card
	local LW, LH = 390, 300
	local fit = math.min(1, (vp.X - 20) / LW, (vp.Y - 20) / LH)
	local shell = New("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(LW, LH), Position = UDim2.fromScale(0.5, 0.5),
		BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 30,
	}, gui)
	Round(shell, 18)
	local lstroke = New("UIStroke", { Thickness = 2.5, Transparency = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, shell)
	Themed(lstroke, "Color", "hi")
	local lscale = New("UIScale", { Scale = 0.9 * fit }, shell)
	local canvas = New("CanvasGroup", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, GroupTransparency = 1, Active = true }, shell)
	Round(canvas, 18)
	GradientFill(canvas)

	local function Page()
		return New("CanvasGroup", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0 }, canvas)
	end
	local function Center(l, y, h)
		l.Position = UDim2.fromOffset(0, y); l.Size = UDim2.new(1, 0, 0, h)
	end

	-- loading page
	local loadPage = Page()
	local spinHold = New("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 24), Size = UDim2.fromOffset(46, 46), BackgroundTransparency = 1 }, loadPage)
	local ringBack = New("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 }, spinHold)
	Round(ringBack, 46); Outline(ringBack, "accent", 3, 0.75)
	local ringFront = New("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 }, spinHold)
	Round(ringFront, 46)
	local spinStroke = Outline(ringFront, "hi", 3, 0)
	local spinGrad = New("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.5, 0.2),
			NumberSequenceKeypoint.new(0.72, 1), NumberSequenceKeypoint.new(1, 1),
		}),
	}, spinStroke)

	local lt = Label(loadPage, tostring(cfg.Title or "free script by Yuan"), 23, "text", FB, Enum.TextXAlignment.Center); Center(lt, 82, 30)
	local ls = Label(loadPage, tostring(cfg.Subtitle or "join official server"), 13, "dim", FM, Enum.TextXAlignment.Center); Center(ls, 114, 18)

	local copyBtn = New("TextButton", {
		Text = "Copy invite link", TextSize = 13, Font = FB, AutoButtonColor = false, BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 142), Size = UDim2.fromOffset(200, 34),
	}, loadPage)
	Themed(copyBtn, "BackgroundColor3", "accent"); Themed(copyBtn, "TextColor3", "text")
	Round(copyBtn, 17); Juice(copyBtn, "accent", "hi")
	local copyToken = 0
	copyBtn.MouseButton1Click:Connect(function()
		local clip = setclipboard or toclipboard or (Clipboard and Clipboard.set)
		local ok = false
		if clip and cfg.Link then
			local s, err = pcall(clip, cfg.Link)
			ok = s
			if not s then warn(TAG, "clipboard error:", err) end
		else
			warn(TAG, "no clipboard function. Invite link:", cfg.Link)
		end
		copyToken = copyToken + 1
		local my = copyToken
		copyBtn.Text = ok and "Copied!" or "Link printed in console"
		copyBtn.TextColor3 = Color3.fromRGB(16, 12, 10)
		Tw(copyBtn, 0.2, { BackgroundColor3 = ok and Palette.good or Palette.warn })
		task.delay(1.6, function()
			if copyToken ~= my or not copyBtn.Parent then return end
			copyBtn.Text = "Copy invite link"
			copyBtn.TextColor3 = Palette.text
			Tw(copyBtn, 0.3, { BackgroundColor3 = Palette.accent })
		end)
	end)

	local progTrack = New("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 206), Size = UDim2.fromOffset(300, 6), BorderSizePixel = 0 }, loadPage)
	Themed(progTrack, "BackgroundColor3", "panel"); Round(progTrack, 3)
	local progFill = New("Frame", { Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0 }, progTrack)
	Round(progFill, 3)
	New("UIGradient", { Color = ColorSequence.new(Palette.accent, Palette.hi) }, progFill)
	local progStep = Label(loadPage, "Starting...", 11, "dim", FM)
	progStep.Position = UDim2.new(0.5, -150, 0, 218); progStep.Size = UDim2.fromOffset(220, 16)
	local progPct = Label(loadPage, "0%", 11, "hi", FB, Enum.TextXAlignment.Right)
	progPct.Position = UDim2.new(0.5, 70, 0, 218); progPct.Size = UDim2.fromOffset(80, 16)
	local foot = Label(loadPage, tostring(cfg.Footer or "Syntax UI"), 10, "dim", FM, Enum.TextXAlignment.Center)
	foot.Position = UDim2.new(0, 0, 1, -26); foot.Size = UDim2.new(1, 0, 0, 14); foot.TextTransparency = 0.35

	-- warning page
	local warnPage = Page()
	warnPage.Visible = false; warnPage.GroupTransparency = 1
	New("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 10),
		HorizontalAlignment = Enum.HorizontalAlignment.Center, VerticalAlignment = Enum.VerticalAlignment.Center,
	}, warnPage)
	local badge = New("Frame", { Size = UDim2.fromOffset(40, 40), BackgroundTransparency = 0.82, BorderSizePixel = 0, LayoutOrder = 1 }, warnPage)
	Themed(badge, "BackgroundColor3", "warn"); Round(badge, 40); Outline(badge, "warn", 2, 0.1)
	local mark = Label(badge, "!", 22, "warn", FB, Enum.TextXAlignment.Center); mark.Size = UDim2.fromScale(1, 1)
	local wt = Label(warnPage, tostring(cfg.WarnTitle or "Use at your own risk"), 18, "warn", FB, Enum.TextXAlignment.Center)
	wt.Size = UDim2.new(1, -24, 0, 22); wt.LayoutOrder = 2
	local wb = Label(warnPage, tostring(cfg.WarnBody or "This script automates gameplay actions.\nThe author is not responsible for any bans."), 12, "dim", FM, Enum.TextXAlignment.Center)
	wb.TextWrapped = true; wb.Size = UDim2.new(1, -32, 0, 44); wb.LayoutOrder = 3
	local startBtn = New("TextButton", {
		Text = "START", TextSize = 15, Font = FB, TextColor3 = Color3.fromRGB(18, 12, 8), AutoButtonColor = false,
		BorderSizePixel = 0, Size = UDim2.fromOffset(150, 40), LayoutOrder = 4,
	}, warnPage)
	Themed(startBtn, "BackgroundColor3", "hi"); Round(startBtn, 20); Juice(startBtn, "hi", "warn")

	-- frame loop
	local t0 = os.clock()
	local conn = RunService.RenderStepped:Connect(function(dt)
		local t = os.clock() - t0
		fade = fade + (fadeGoal - fade) * (1 - math.exp(-dt * 2.6))
		for _, b in ipairs(bokeh) do
			b.f.Position = UDim2.new(b.bx, math.sin(t * b.sp + b.ph) * b.ax, b.by, math.cos(t * b.sp * 0.8 + b.ph) * b.ay)
			local pulse = math.sin(t * b.sp * 2 + b.ph) * 0.03
			b.f.BackgroundTransparency = 1 - (1 - (b.base + pulse)) * fade
			b.st.Transparency = 1 - (1 - b.sbase) * fade
		end
		dimmer.BackgroundTransparency = 1 - 0.04 * fade
		spinGrad.Rotation = (t * 330) % 360
		progShown = progShown + (progGoal - progShown) * (1 - math.exp(-dt * 7))
		progFill.Size = UDim2.new(math.clamp(progShown, 0, 1), 0, 1, 0)
		progPct.Text = string.format("%d%%", math.floor(progShown * 100 + 0.5))
		lstroke.Thickness = 2.6 + math.sin(t * 2) * 0.25
	end)
	Conns[#Conns + 1] = conn

	local function cleanup()
		pcall(function() conn:Disconnect() end)
		pcall(function() layer:Destroy() end)
		pcall(function() shell:Destroy() end)
		if blur then pcall(function() blur:Destroy() end) end
	end
	local function gone() return lib.Unloaded or not gui.Parent end

	startBtn.MouseButton1Click:Connect(function()
		if started then return end
		started = true
		fadeGoal = 0
		Tw(lscale, 0.55, { Scale = 1.08 * fit }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
		Tw(canvas, 0.45, { GroupTransparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		Tw(lstroke, 0.45, { Transparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		if blur then Tw(blur, 0.8, { Size = 0 }) end
		task.delay(0.4, function() if not gone() then Safe(onDone) end end)
		task.delay(1.3, cleanup)
	end)

	local steps = cfg.Steps or {
		{ "Loading modules...", 0.2 }, { "Building interface...", 0.45 }, { "Binding hooks...", 0.7 },
		{ "Almost there...", 0.9 }, { "Ready!", 1 },
	}
	task.spawn(function()
		task.wait(0.05)
		Tw(lscale, 0.75, { Scale = fit }, Enum.EasingStyle.Back)
		Tw(canvas, 0.6, { GroupTransparency = 0 })
		Tw(lstroke, 0.6, { Transparency = 0 })
		task.wait(0.5)
		for _, s in ipairs(steps) do
			if gone() then return end
			progStep.Text = s[1]; progGoal = s[2]
			task.wait(0.55)
		end
		task.wait(0.35)
		if gone() then return end
		Tw(loadPage, 0.3, { GroupTransparency = 1 })
		task.wait(0.3)
		loadPage.Visible = false
		warnPage.Position = UDim2.fromOffset(0, 10)
		warnPage.Visible = true
		Tw(warnPage, 0.45, { GroupTransparency = 0, Position = UDim2.fromOffset(0, 0) })
	end)
end

