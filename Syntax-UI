local Palette = {}
for k, v in pairs(Library.Themes["Syntax Orange"]) do Palette[k] = v end
Library.Palette = Palette

local Registry, Refreshers, Conns = {}, {}, {}
local FB, FM = Enum.Font.GothamBold, Enum.Font.GothamMedium

local function Bind(sig, fn)
	local c = sig:Connect(fn)
	Conns[#Conns + 1] = c
	return c
end

local function Trace(e) return debug.traceback(tostring(e), 2) end

local function Safe(fn, ...)
	if type(fn) ~= "function" then return end
	local ok, err = xpcall(fn, Trace, ...)
	if not ok then warn(TAG, "callback error:", err) end
end

-- ===================== helpers =====================
local function New(class, props, parent)
	local o = Instance.new(class)
	if props then for k, v in pairs(props) do o[k] = v end end
	if parent then o.Parent = parent end
	return o
end

local function Themed(obj, prop, key)
	Registry[#Registry + 1] = { obj = obj, prop = prop, key = key }
	obj[prop] = Palette[key]
	return obj
end

local function Round(p, r) return New("UICorner", { CornerRadius = UDim.new(0, r) }, p) end

local function Outline(p, key, th, tr)
	local s = New("UIStroke", { Thickness = th, Transparency = tr or 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, p)
	Themed(s, "Color", key)
	return s
end

local function Tw(o, t, props, es, ed)
	local tw = TweenService:Create(o, TweenInfo.new(t, es or Enum.EasingStyle.Quint, ed or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

local function Label(parent, text, size, key, font, xa)
	local l = New("TextLabel", {
		Text = text, TextSize = size, Font = font or FM, BackgroundTransparency = 1, BorderSizePixel = 0,
		TextXAlignment = xa or Enum.TextXAlignment.Left,
	}, parent)
	Themed(l, "TextColor3", key or "text")
	return l
end

local function Juice(btn, baseKey, hoverKey)
	local sc = New("UIScale", { Scale = 1 }, btn)
	btn.MouseEnter:Connect(function() Tw(btn, 0.12, { BackgroundColor3 = Palette[hoverKey] }) end)
	btn.MouseLeave:Connect(function()
		Tw(btn, 0.18, { BackgroundColor3 = Palette[baseKey] })
		Tw(sc, 0.18, { Scale = 1 })
	end)
	btn.MouseButton1Down:Connect(function() Tw(sc, 0.07, { Scale = 0.96 }) end)
	btn.MouseButton1Up:Connect(function() Tw(sc, 0.25, { Scale = 1 }, Enum.EasingStyle.Back) end)
end

local function IsPress(i)
	return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch
end

local function IsMove(i)
	return i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch
end

-- ===================== theme api =====================
function Library:SetTheme(name)
	local t = self.Themes[name]
	if not t then warn(TAG, "unknown theme:", name) return end
	self.ThemeName = name
	for k, v in pairs(t) do Palette[k] = v end
	local keep = {}
	for _, e in ipairs(Registry) do
		if e.obj and e.obj.Parent then
			Tw(e.obj, 0.25, { [e.prop] = Palette[e.key] })
			keep[#keep + 1] = e
		end
	end
	Registry = keep
	for _, fn in ipairs(Refreshers) do Safe(fn) end
end

-- ===================== gui root =====================
function Library:_Gui()
	if self.Gui and self.Gui.Parent then return self.Gui end
	local gui = New("ScreenGui", {
		Name = "SyntaxUI", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		IgnoreGuiInset = true, DisplayOrder = 999,
	})
	local ok = false
	if type(gethui) == "function" then ok = pcall(function() gui.Parent = gethui() end) end
	if not ok or not gui.Parent then ok = pcall(function() gui.Parent = CoreGui end) end
	if not ok or not gui.Parent then gui.Parent = LocalPlayer:WaitForChild("PlayerGui") end
	local w = 0
	while gui.AbsoluteSize.X < 50 and w < 1 do w = w + task.wait() end
	self.Gui = gui
	return gui
end

function Library:_Viewport()
	local v = self.Gui and self.Gui.AbsoluteSize or Vector2.new(0, 0)
	if v.X < 50 or v.Y < 50 then
		local cam = workspace.CurrentCamera
		v = cam and cam.ViewportSize or Vector2.new(800, 600)
	end
	return v
end

function Library:Destroy()
	self.Unloaded = true
	for _, c in ipairs(Conns) do pcall(function() c:Disconnect() end) end
	Conns = {}
	if self.Gui then pcall(function() self.Gui:Destroy() end) end
	if env.SyntaxUI_Instance == self then env.SyntaxUI_Instance = nil end
end

-- ===================== notifications =====================
function Library:Notify(cfg)
	cfg = cfg or {}
	local gui = self:_Gui()
	if not self._notifyHolder or not self._notifyHolder.Parent then
		local h = New("Frame", {
			AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -14, 1, -14), Size = UDim2.fromOffset(280, 400),
			BackgroundTransparency = 1, ZIndex = 300,
		}, gui)
		New("UIListLayout", {
			SortOrder = Enum.SortOrder.LayoutOrder, VerticalAlignment = Enum.VerticalAlignment.Bottom,
			HorizontalAlignment = Enum.HorizontalAlignment.Right, Padding = UDim.new(0, 6),
		}, h)
		self._notifyHolder = h
	end
	self._notifyN = (self._notifyN or 0) + 1
	local wrap = New("Frame", {
		Size = UDim2.fromOffset(260, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
		LayoutOrder = self._notifyN, ZIndex = 300,
	}, self._notifyHolder)
	local card = New("Frame", {
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BorderSizePixel = 0,
		Position = UDim2.fromOffset(290, 0), ZIndex = 301,
	}, wrap)
	Themed(card, "BackgroundColor3", "bg2"); Round(card, 10); Outline(card, "accent", 1.5, 0.15)
	New("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12), PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8) }, card)
	New("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2) }, card)
	local t = Label(card, tostring(cfg.Title or "Notice"), 13, "hi", FB)
	t.Size = UDim2.new(1, 0, 0, 16); t.ZIndex = 302
	if cfg.Content and cfg.Content ~= "" then
		local c = Label(card, tostring(cfg.Content), 11, "text", FM)
		c.Size = UDim2.new(1, 0, 0, 0); c.AutomaticSize = Enum.AutomaticSize.Y; c.TextWrapped = true
		c.TextYAlignment = Enum.TextYAlignment.Top; c.LayoutOrder = 2; c.ZIndex = 302
	end
	Tw(card, 0.45, { Position = UDim2.fromOffset(0, 0) }, Enum.EasingStyle.Back)
	task.delay(cfg.Duration or 4, function()
		if not card.Parent then return end
		Tw(card, 0.4, { Position = UDim2.fromOffset(290, 0) }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
		task.wait(0.45)
		if wrap.Parent then wrap:Destroy() end
	end)
end

-- ===================== elements =====================
local Elements = {}
Elements.__index = Elements

local OrderMap = setmetatable({}, { __mode = "k" })
local function NextOrder(c)
	local n = (OrderMap[c] or 0) + 1
	OrderMap[c] = n
	return n
end

local function Card(container, height, auto)
	local f = New("Frame", { Size = UDim2.new(1, 0, 0, height or 0), BorderSizePixel = 0, LayoutOrder = NextOrder(container) }, container)
	if auto then f.AutomaticSize = Enum.AutomaticSize.Y end
	Themed(f, "BackgroundColor3", "panel"); Round(f, 8); Outline(f, "accent", 1, 0.7)
	return f
end

local function Header(card, cfg, rightPad)
	local hasDesc = cfg.Description and cfg.Description ~= ""
	local t = Label(card, tostring(cfg.Title or ""), 13, "text", FB)
	t.Position = UDim2.fromOffset(12, hasDesc and 8 or 0)
	t.Size = UDim2.new(1, -(rightPad + 12), 0, hasDesc and 18 or card.Size.Y.Offset)
	t.TextTruncate = Enum.TextTruncate.AtEnd
	local d
	if hasDesc then
		d = Label(card, tostring(cfg.Description), 10, "dim", FM)
		d.TextWrapped = true; d.Position = UDim2.fromOffset(12, 28); d.Size = UDim2.new(1, -(rightPad + 12), 0, 16)
		d.TextTruncate = Enum.TextTruncate.AtEnd
	end
	return t, d
end

local function Fire(obj, v)
	Safe(obj.Callback, v)
	for _, fn in ipairs(obj._changed) do Safe(fn, v) end
end

local function BaseOption(kind, idx, cfg)
	local o = { Type = kind, Value = nil, Callback = cfg.Callback, _changed = {} }
	function o:OnChanged(fn) self._changed[#self._changed + 1] = fn end
	if idx then Library.Options[idx] = o end
	return o
end

local function MakeSwitch(parent, w, h)
	local pad, kd = 3, h - 6
	local track = New("Frame", { Size = UDim2.fromOffset(w, h), BorderSizePixel = 0 }, parent)
	Round(track, h)
	local st = New("UIStroke", { Thickness = 1.2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, track)
	local knob = New("Frame", {
		AnchorPoint = Vector2.new(0, 0.5), Size = UDim2.fromOffset(kd, kd), Position = UDim2.new(0, pad, 0.5, 0), BorderSizePixel = 0,
	}, track)
	Round(knob, kd)
	local sw = { track = track, on = false }
	local function paint(instant)
		local pos = sw.on and UDim2.new(1, -kd - pad, 0.5, 0) or UDim2.new(0, pad, 0.5, 0)
		local col = sw.on and Palette.hi or Palette.off
		local str = sw.on and 0 or 0.5
		if instant then
			knob.Position, track.BackgroundColor3, st.Transparency = pos, col, str
		else
			Tw(knob, 0.4, { Position = pos }, Enum.EasingStyle.Back)
			Tw(track, 0.25, { BackgroundColor3 = col })
			Tw(st, 0.25, { Transparency = str })
		end
		st.Color = Palette.accent
		knob.BackgroundColor3 = Palette.knob
	end
	function sw.set(on, instant) sw.on = on and true or false; paint(instant) end
	Refreshers[#Refreshers + 1] = function() if track.Parent then paint(true) end end
	paint(true)
	return sw
end

