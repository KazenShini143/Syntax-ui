function Syntax:SelectTab(tab)
    for _, other in ipairs(self.Tabs) do
        local active = other == tab; other.Page.Visible = active
        tween(other.NavButton, .16, {BackgroundColor3 = active and self.Theme.Primary or self.Theme.SurfaceAlt, TextColor3 = active and self.Theme.Text or self.Theme.Muted, BackgroundTransparency = active and 0 or .16})
    end
    tab.Page.Position = UDim2.fromOffset(20, 40); tween(tab.Page, .2, {Position = UDim2.fromOffset(14, 40)})
end

