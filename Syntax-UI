	Themed(topLine, "BackgroundColor3", "hi")
	local logo = New("Frame", { Position = UDim2.fromOffset(13, 15), Size = UDim2.fromOffset(12, 12), BorderSizePixel = 0 }, top)
	Themed(logo, "BackgroundColor3", "hi"); Round(logo, 12)
	local logoGlow = New("UIStroke", { Thickness = 3, Transparency = 0.7 }, logo)
	Themed(logoGlow, "Color", "hi")
	local tl = Label(top, tostring(cfg.Title or "Syntax"), 14, "text", FB)
	tl.Position = UDim2.fromOffset(34, 6); tl.Size = UDim2.new(1, -100, 0, 17); tl.ZIndex = 6
	local sub = cfg.SubTitle or cfg.Subtitle
	local sl = Label(top, tostring(sub or ""), 10, "hi", FM)
	sl.Position = UDim2.fromOffset(34, 23); sl.Size = UDim2.new(1, -100, 0, 13); sl.ZIndex = 6

	local minBtn = New("TextButton", {
		Text = "", AutoButtonColor = false, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0),
		Size = UDim2.fromOffset(28, 28), BorderSizePixel = 0, ZIndex = 6,
	}, top)
	Themed(minBtn, "BackgroundColor3", "panel"); Round(minBtn, 9); Juice(minBtn, "panel", "panel2")
	local dash = New("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(12, 2), BorderSizePixel = 0, ZIndex = 7 }, minBtn)
	Themed(dash, "BackgroundColor3", "text")

	-- sidebar + content
	local sbW = math.floor(math.min(140, W * 0.28))
	local sidebar = New("ScrollingFrame", {
		Position = UDim2.fromOffset(8, 50), Size = UDim2.new(0, sbW, 1, -58), BackgroundTransparency = 1, BorderSizePixel = 0,
		ScrollBarThickness = 0, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
	}, canvas)
	New("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 4) }, sidebar)
	local content = New("Frame", {
		Position = UDim2.fromOffset(sbW + 16, 50), Size = UDim2.new(1, -(sbW + 24), 1, -58), BackgroundTransparency = 1, ClipsDescendants = true,
	}, canvas)

	-- minimized pill
	local pill = self:MakePill({
		Name = tostring(cfg.Title or "Syntax"), SubText = "tap to open", Width = 198,
		Position = UDim2.fromOffset(R(vp.X / 8), R(vp.Y / 2)),
		OnExpand = function() win:Restore() end,
	})
	win.Pill = pill

	-- open / minimize / restore
	function win:Open()
		if self.Opened then return end
		self.Opened = true
		shell.Visible = true
		Tw(scale, 0.6, { Scale = userScale }, Enum.EasingStyle.Back)
		Tw(canvas, 0.45, { GroupTransparency = 0 })
		Tw(stroke, 0.45, { Transparency = 0 })
		layoutLive = true
	end
	function win:Minimize()
		if animBusy or self.Minimized or not self.Opened then return end
		animBusy, self.Minimized, layoutLive = true, true, false
		local p = pill.Shell.Position
		Tw(shell, 0.46, { Position = UDim2.fromOffset(p.X.Offset, p.Y.Offset) }, Enum.EasingStyle.Quint, Enum.EasingDirection.InOut)
		Tw(scale, 0.46, { Scale = 0.16 }, Enum.EasingStyle.Quint, Enum.EasingDirection.InOut)
		Tw(canvas, 0.34, { GroupTransparency = 1 })
		Tw(stroke, 0.34, { Transparency = 1 })
		task.delay(0.28, function() pill:Show() end)
		task.delay(0.5, function() shell.Visible = false; animBusy = false end)
	end
	function win:Restore()
		if animBusy or not self.Minimized then return end
		animBusy, self.Minimized = true, false
		pill:Hide()
		local p = pill.Shell.Position
		shell.Position = UDim2.fromOffset(p.X.Offset, p.Y.Offset)
		scale.Scale = 0.16; canvas.GroupTransparency = 1; stroke.Transparency = 1
		shell.Visible = true
		Tw(shell, 0.52, { Position = UDim2.fromOffset(R(pos.x), R(pos.y)) })
		Tw(scale, 0.58, { Scale = userScale }, Enum.EasingStyle.Back)
		Tw(canvas, 0.4, { GroupTransparency = 0 })
		Tw(stroke, 0.4, { Transparency = 0 })
		task.delay(0.6, function() layoutLive = true; animBusy = false end)
	end
	function win:Toggle() if self.Minimized then self:Restore() else self:Minimize() end end
	function win:SetScale(v)
		userScale = math.clamp(tonumber(v) or 1, 0.5, 1.5)
		if self.Opened and not self.Minimized and not animBusy then Tw(scale, 0.2, { Scale = userScale }) end
	end
	function win:SetMiniToggle() end
	function win:MiniNotify(c) Library:Notify(c) end
	function win:Destroy() Library:Destroy() end

	minBtn.MouseButton1Click:Connect(function() win:Minimize() end)
	Bind(UserInputService.InputBegan, function(i, gp)
		if gp then return end
		if i.UserInputType == Enum.UserInputType.Keyboard and i.KeyCode == Library.MinimizeKeybind then win:Toggle() end
	end)

	-- smooth drag
	local dragging, dStart, dOrig = false, nil, nil
	top.InputBegan:Connect(function(i)
		if IsPress(i) and layoutLive then
			dragging = true; dStart = i.Position; dOrig = Vector2.new(goal.x, goal.y)
			local c
			c = i.Changed:Connect(function()
				if i.UserInputState == Enum.UserInputState.End then dragging = false; c:Disconnect() end
			end)
		end
	end)
	Bind(UserInputService.InputChanged, function(i)
		if dragging and IsMove(i) then
			local d = i.Position - dStart
			local v = Library:_Viewport()
			goal.x = math.clamp(dOrig.X + d.X, 60, math.max(60, v.X - 60))
			goal.y = math.clamp(dOrig.Y + d.Y, 40, math.max(40, v.Y - 40))
		end
	end)

	-- frame loop: smooth follow + glow
	local t0 = os.clock()
	Bind(RunService.RenderStepped, function(dt)
		local t = os.clock() - t0
		if layoutLive and shell.Visible then
			local a = 1 - math.exp(-dt * 20)
			pos.x = pos.x + (goal.x - pos.x) * a
			pos.y = pos.y + (goal.y - pos.y) * a
			shell.Position = UDim2.fromOffset(R(pos.x), R(pos.y))
		end
		if shell.Visible then
			logoGlow.Transparency = 0.6 + math.sin(t * 2.4) * 0.2
			stroke.Thickness = 2.6 + math.sin(t * 2) * 0.25
		end
	end)

	-- tabs
	local function paintTabs()
		for _, t in ipairs(win.Tabs) do
			local active = (t == win.Current)
			Tw(t.Btn, 0.25, { BackgroundColor3 = active and Palette.accent or Palette.panel, BackgroundTransparency = active and 0 or 0.35 })
		end
	end
	Refreshers[#Refreshers + 1] = function() if shell.Parent then paintTabs() end end

	function win:SelectTab(t)
		if type(t) == "number" then t = self.Tabs[t] end
		if not t or t == self.Current then return end
		self.Current = t
		for _, o in ipairs(self.Tabs) do
			if o == t then
				o.Group.Position = UDim2.fromOffset(0, 12)
				o.Group.GroupTransparency = 1
				o.Group.Visible = true
				Tw(o.Group, 0.38, { GroupTransparency = 0, Position = UDim2.fromOffset(0, 0) })
			else
				o.Group.Visible = false
			end
		end
		paintTabs()
	end

	function win:AddTab(c)
		if type(c) == "string" then c = { Title = c } end
		c = c or {}
		local btn = New("TextButton", {
			Text = "", AutoButtonColor = false, Size = UDim2.new(1, 0, 0, 32), BorderSizePixel = 0, LayoutOrder = #self.Tabs + 1,
		}, sidebar)
		Themed(btn, "BackgroundColor3", "panel"); btn.BackgroundTransparency = 0.35; Round(btn, 8)
		local bl = Label(btn, tostring(c.Title or "Tab"), 12, "text", FB)
		bl.Position = UDim2.fromOffset(10, 0); bl.Size = UDim2.new(1, -14, 1, 0); bl.TextTruncate = Enum.TextTruncate.AtEnd

		local group = New("CanvasGroup", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, Visible = false }, content)
		local page = New("ScrollingFrame", {
			Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3,
			CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
		}, group)
		page.ScrollBarImageColor3 = Palette.hi
		New("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6) }, page)
		New("UIPadding", { PaddingRight = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6) }, page)

		local tab = setmetatable({ Title = c.Title, Window = self, Container = page, Page = page, Group = group, Btn = btn }, Elements)
		self.Tabs[#self.Tabs + 1] = tab
		btn.MouseButton1Click:Connect(function() self:SelectTab(tab) end)
		if #self.Tabs == 1 then self:SelectTab(tab) else paintTabs() end
		return tab
	end

	self.Windows[#self.Windows + 1] = win

	if cfg.Intro then
		self:_RunIntro(type(cfg.Intro) == "table" and cfg.Intro or {}, function() win:Open() end)
	else
		win:Open()
	end
	return win
end

-- ===================== floating toggles (user-configurable) =====================
function Library:BuildFloatingToggleSection(tab, slotCount)
	slotCount = slotCount or 3
	local Lib = self
	local vp = self:_Viewport()
	local targetMap = {}

	local function collect()
		targetMap = {}
		local idxs = {}
		for idx, o in pairs(Lib.Options) do
			if o.Type == "Toggle" and not tostring(idx):match("^FT%d") then idxs[#idxs + 1] = idx end
		end
		table.sort(idxs, function(a, b) return tostring(a) < tostring(b) end)
		local names = {}
		for _, idx in ipairs(idxs) do
			local nm = tostring(Lib.Options[idx].Title or idx)
			if targetMap[nm] then nm = nm .. " [" .. tostring(idx) .. "]" end
			targetMap[nm] = idx
			names[#names + 1] = nm
		end
		table.sort(names)
		if #names == 0 then names = { "None" } end
		return names
	end

	tab:AddSection("Floating Toggles")
	tab:AddParagraph({
		Title = "Custom floating toggles",
		Content = "Each slot is a draggable on-screen switch. Pick any toggle from the list, give it your own label, and flip it without opening the menu. Grab the dots to move it.",
	})

	local slots = {}
	local names = collect()
	for n = 1, slotCount do
		local slot = { n = n }
		slot.pill = Lib:MakePill({
			Name = "Toggle " .. n, SubText = "OFF", Width = 176, ShowSwitch = true, ZIndex = 20 + n,
			Position = UDim2.fromOffset(R(vp.X / 8), R(vp.Y / 2 + (n - 1) * 58)),
			OnToggle = function()
				local o = slot.target and Lib.Options[slot.target]
				if o and o.SetValue then o:SetValue(not o.Value) end
			end,
		})
		slots[#slots + 1] = slot

		function slot.refresh()
			local o = slot.target and Lib.Options[slot.target]
			local custom = slot.labelIn and slot.labelIn.Value or ""
			local label = (custom ~= "" and custom) or (o and tostring(o.Title or slot.target)) or "Pick a toggle"
			slot.pill:SetName(label)
			if o then slot.pill:SetState(o.Value) end
			local show = slot.enable and slot.enable.Value and o ~= nil
			if show and not slot.pill.Visible then slot.pill:Show()
			elseif not show and slot.pill.Visible then slot.pill:Hide() end
		end

		tab:AddSection("Slot " .. n)
		slot.enable = tab:AddToggle("FT" .. n .. "_Enabled", {
			Title = "Show floating toggle " .. n, Default = false, Callback = function() slot.refresh() end,
		})
		slot.targetDd = tab:AddDropdown("FT" .. n .. "_Target", {
			Title = "Controls", Description = "Which toggle this button flips", Values = names,
			Callback = function(v) slot.target = targetMap[v]; slot.refresh() end,
		})
		slot.labelIn = tab:AddInput("FT" .. n .. "_Label", {
			Title = "Custom label (empty = use the toggle's name)", Placeholder = "e.g. Farm", Finished = true,
			Callback = function() slot.refresh() end,
		})
		slot.sizeSl = tab:AddSlider("FT" .. n .. "_Size", {
			Title = "Button size", Default = 1, Min = 0.7, Max = 1.4, Rounding = 2,
			Callback = function(v) slot.pill:SetScale(v) end,
		})
	end

	tab:AddButton({
		Title = "Refresh toggle list", Description = "Re-scan features (use after anything new loads)",
		Callback = function()
			local fresh = collect()
			for _, s in ipairs(slots) do s.targetDd:SetValues(fresh) end
			Lib:Notify({ Title = "Floating Toggles", Content = #fresh .. " toggle(s) available.", Duration = 2 })
		end,
	})

	-- keep every floating switch in sync with the real toggle
	Bind(RunService.Heartbeat, function()
		for _, s in ipairs(slots) do
			if s.pill.Visible and s.target then
				local o = Lib.Options[s.target]
				if o then s.pill:SetState(o.Value) end
			end
		end
	end)
	return slots
end

return Library
