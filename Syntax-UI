	end)

	-- bokeh (transparent, the game stays visible)
	local layer = New("Frame", { Name = "SyntaxBokeh", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 1, ClipsDescendants = true }, gui)
	local dimmer = New("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 1 }, layer)
	local colors = {
