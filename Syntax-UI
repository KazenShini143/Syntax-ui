function Syntax:ApplyTheme(theme)
    if type(theme) == "string" then theme = self.Themes[theme] end
    if type(theme) ~= "table" then return self end
    self.Theme = copy(theme)
    local t = self.Theme
    safe(function()
        self.Main.BackgroundColor3 = t.Background
        self.Nav.BackgroundColor3 = t.Surface
        self.Content.BackgroundColor3 = t.Background
        self.Border.Color = t.Secondary
        self.TopGlow.BackgroundColor3 = t.Primary
        self.TopGlowGradient.Color = ColorSequence.new(t.GradientA, t.GradientB)
        self.MiniToggle.BackgroundColor3 = t.Primary
        for _, tab in ipairs(self.Tabs) do
            tab.Page.BackgroundColor3 = t.Background
            tab.NavButton.TextColor3 = t.Muted
            for _, section in ipairs(tab.Sections) do
                section.Frame.BackgroundColor3 = t.Surface
                section.Title.TextColor3 = t.Success
            end
        end
    end)
    return self
end

function Syntax:SetTheme(theme) return self:ApplyTheme(theme) end
function Syntax:SetThemeName(name)
    if self.Themes[name] then self.ThemeName = name; self:ApplyTheme(name) end
    return self
end

