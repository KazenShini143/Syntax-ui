function Elements:AddToggle(idx, cfg)
    cfg = cfg or {}
    local hasDesc = cfg.Description and cfg.Description ~= ""
    local card = Card(self.Container, hasDesc and 54 or 42)
    local hit = New("TextButton", { Text = "", AutoButtonColor = false, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) }, card)
    Header(card, cfg, 66)
    local sw = MakeSwitch(card, 50, 26)
    sw.track.AnchorPoint = Vector2.new(1, 0.5); sw.track.Position = UDim2.new(1, -12, 0.5, 0)
    local T = BaseOption("Toggle", idx, cfg)
    T.Value = false
    function T:SetValue(v, silent)
        v = v and true or false
        local changed = (self.Value ~= v)
        self.Value = v
        sw.set(v)
        if changed and not silent then Fire(self, v) end
    end
    hit.MouseButton1Click:Connect(function() T:SetValue(not T.Value) end)
    if cfg.Default then T:SetValue(true) end
    return T
end

function Elements:AddSlider(idx, cfg)
    cfg = cfg or {}
    local mn, mx = cfg.Min or 0, cfg.Max or 100
    local rounding = cfg.Rounding or 0
    local card = Card(self.Container, 62)
    local t = Label(card, cfg.Title or "", 11, "dim", FB)
    t.Position = UDim2.fromOffset(12, 6); t.Size = UDim2.new(0.65, 0, 0, 16)
    local vl = Label(card, "", 12, "hi", FB, Enum.TextXAlignment.Right)
    vl.Position = UDim2.new(0.65, 0, 0, 5); vl.Size = UDim2.new(0.35, -14, 0, 18)
    local hit = New("Frame", { Position = UDim2.fromOffset(14, 26), Size = UDim2.new(1, -28, 0, 28), BackgroundTransparency = 1 }, card)
    local track = New("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.new(1, 0, 0, 6), BorderSizePixel = 0 }, hit)
    Themed(track, "BackgroundColor3", "bg"); Round(track, 3)
    local fill = New("Frame", { Size = UDim2.new(0, 0, 1, 0), BorderSizePixel = 0 }, track)
    Themed(fill, "BackgroundColor3", "hi"); Round(fill, 3)
    local knob = New("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.fromOffset(16, 16), BorderSizePixel = 0, ZIndex = 3 }, track)
    Themed(knob, "BackgroundColor3", "knob"); Round(knob, 16); Outline(knob, "hi", 2, 0.1)
    local S = BaseOption("Slider", idx, cfg)
    S.Value = mn
    function S:SetValue(v, silent)
        v = math.clamp(tonumber(v) or mn, mn, mx)
        local m = 10 ^ rounding
        v = math.floor(v * m + 0.5) / m
        local changed = (self.Value ~= v)
        self.Value = v
        vl.Text = (rounding > 0) and string.format("%." .. rounding .. "f", v) or tostring(v)
        local a = (mx > mn) and (v - mn) / (mx - mn) or 0
        Tw(fill, 0.1, { Size = UDim2.new(a, 0, 1, 0) }, Enum.EasingStyle.Quad)
        Tw(knob, 0.1, { Position = UDim2.new(a, 0, 0.5, 0) }, Enum.EasingStyle.Quad)
        if changed and not silent then Fire(self, v) end
    end
    local sliding = false
    local function fromX(x)
        local w = math.max(1, track.AbsoluteSize.X)
        local a = math.clamp((x - track.AbsolutePosition.X) / w, 0, 1)
        S:SetValue(mn + a * (mx - mn))
    end
    hit.InputBegan:Connect(function(i) if IsPress(i) then sliding = true; fromX(i.Position.X) end end)
    Bind(UserInputService.InputChanged, function(i)
        if sliding and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then fromX(i.Position.X) end
    end)
    Bind(UserInputService.InputEnded, function(i) if IsPress(i) then sliding = false end end)
    S:SetValue(cfg.Default or mn, true)
    return S
end

