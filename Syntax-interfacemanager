--[[
    Syntax UI  -  InterfaceManager  (Fluent-compatible API)
    Adds an "Interface" section: theme picker, window scale, menu keybind. Settings are remembered per folder.

        local InterfaceManager = loadstring(game:HttpGet("<raw link>/SyntaxInterfaceManager.lua"))()
        InterfaceManager:SetLibrary(Syntax)
        InterfaceManager:SetFolder("SyntaxHub")
        InterfaceManager:BuildInterfaceSection(Tabs.Settings)
]]

local HttpService = game:GetService("HttpService")
local TAG = "[Syntax InterfaceManager]"

local Manager = {
    Folder = "SyntaxUI",
    Library = nil,
    Settings = { Theme = "Syntax Orange", Scale = 1, MenuKeybind = "RightShift" },
}

local function hasFS()
    return type(writefile) == "function" and type(readfile) == "function" and type(isfolder) == "function"
        and type(makefolder) == "function" and type(isfile) == "function"
end

function Manager:SetLibrary(lib) self.Library = lib end
function Manager:SetFolder(folder)
    self.Folder = folder
    if hasFS() then pcall(function() if not isfolder(folder) then makefolder(folder) end end) end
end

function Manager:Save()
    if not hasFS() then return end
    local ok, json = pcall(function() return HttpService:JSONEncode(self.Settings) end)
    if ok then pcall(writefile, self.Folder .. "/interface.json", json) end
end

function Manager:Load()
    if not hasFS() then return end
    local path = self.Folder .. "/interface.json"
    if not isfile(path) then return end
    local ok, data = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
    if ok and type(data) == "table" then
        for k, v in pairs(data) do self.Settings[k] = v end
    end
end

function Manager:BuildInterfaceSection(tab)
    assert(self.Library, "InterfaceManager: call SetLibrary first")
    local Lib = self.Library
    self:Load()
    tab:AddSection("Interface")

    local themeNames = {}
    for name in pairs(Lib.Themes) do themeNames[#themeNames + 1] = name end
    table.sort(themeNames)

    local function applyScale(v)
        for _, w in ipairs(Lib.Windows) do if w.SetScale then w:SetScale(v) end end
    end

    local theme = tab:AddDropdown("InterfaceTheme", { Title = "Theme", Description = "Changes the whole UI colours", Values = themeNames, Default = self.Settings.Theme })
    theme:OnChanged(function(v)
        Lib:SetTheme(v)
        self.Settings.Theme = v
        self:Save()
    end)

    local scale = tab:AddSlider("InterfaceScale", { Title = "Window scale", Default = self.Settings.Scale, Min = 0.7, Max = 1.3, Rounding = 2 })
    scale:OnChanged(function(v)
        applyScale(v)
        self.Settings.Scale = v
        self:Save()
    end)

    local key = tab:AddKeybind("MenuKeybind", { Title = "Minimize keybind", Default = self.Settings.MenuKeybind,
        ChangedCallback = function(k)
            if k and k ~= Enum.KeyCode.Unknown then Lib.MinimizeKeybind = k end
        end })
    key:OnChanged(function(v)
        self.Settings.MenuKeybind = v
        self:Save()
    end)

    -- apply saved settings
    if Lib.Themes[self.Settings.Theme] then Lib:SetTheme(self.Settings.Theme) end
    applyScale(self.Settings.Scale)
    local kc = Enum.KeyCode[self.Settings.MenuKeybind]
    if kc then Lib.MinimizeKeybind = kc end
end

return Manager
