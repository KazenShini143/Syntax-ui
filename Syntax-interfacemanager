-- Syntax UI InterfaceManager Addon
-- Theme, visibility, keybind, and interface-state helpers.

local InterfaceManager = {Library = nil, _connections = {}}
InterfaceManager.__index = InterfaceManager

local function safe(fn, fallback)
    local ok, result = pcall(fn)
    if ok then return result end
    return fallback
end

function InterfaceManager:SetLibrary(library)
    self.Library = library
    return self
end

function InterfaceManager:SetFolder(folder)
    self.Folder = folder
    return self
end

function InterfaceManager:SetKeybind(keyCode)
    self.Keybind = keyCode
    return self
end

function InterfaceManager:ApplyTheme(nameOrTheme)
    if not self.Library then return false end
    local theme = type(nameOrTheme) == "table" and nameOrTheme or (self.Library.Themes[nameOrTheme] or self.Library.Themes.Dark)
    self.Library:SetTheme(theme)
    return true
end

function InterfaceManager:ToggleUI()
    if not self.Library or not self.Library.Main then return false end
    self.Library.Main.Visible = not self.Library.Main.Visible
    if self.Library.MiniToggle then self.Library.MiniToggle.Visible = not self.Library.Main.Visible end
    return self.Library.Main.Visible
end

function InterfaceManager:BuildInterfaceSection(tab)
    local section = tab:AddSection("INTERFACE")
    section:AddDropdown({Title = "Theme", Values = {"Dark"}, Default = "Dark"}, function(value)
        self:ApplyTheme(value)
    end)
    section:AddButton({Title = "Toggle UI", Callback = function() self:ToggleUI() end})
    section:AddTitle("Use the configured keybind or call InterfaceManager:ToggleUI() from your controller.")
    return section
end

function InterfaceManager:BindToggle(keyCode)
    self:SetKeybind(keyCode)
    local connection = safe(function()
        return game:GetService("UserInputService").InputBegan:Connect(function(input, processed)
            if processed then return end
            if input.KeyCode == self.Keybind then self:ToggleUI() end
        end)
    end)
    if connection then table.insert(self._connections, connection) end
    return connection
end

function InterfaceManager:Destroy()
    for _, connection in ipairs(self._connections) do safe(function() connection:Disconnect() end) end
    self._connections = {}
end

return InterfaceManager
