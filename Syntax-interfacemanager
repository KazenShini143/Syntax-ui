-- Syntax UI | InterfaceManager
-- Theme selection, live scale slider, auto-load preference, and visibility keybind.

local InterfaceManager = {Library = nil, SaveManager = nil, _connections = {}, Keybind = Enum.KeyCode.RightControl}
InterfaceManager.__index = InterfaceManager

local function safe(fn, fallback)
    local ok, value = pcall(fn)
    if ok then return value end
    return fallback
end

function InterfaceManager:SetLibrary(library) self.Library = library; return self end
function InterfaceManager:SetSaveManager(manager) self.SaveManager = manager; return self end
function InterfaceManager:SetFolder(folder) self.Folder = folder; return self end
function InterfaceManager:SetKeybind(keyCode) self.Keybind = keyCode or self.Keybind; return self end
function InterfaceManager:ApplyTheme(nameOrTheme)
    if not self.Library then return false end
    if type(nameOrTheme) == "string" and self.Library.Themes[nameOrTheme] then self.Library:SetThemeName(nameOrTheme) else self.Library:SetTheme(nameOrTheme) end
    return true
end
function InterfaceManager:ToggleUI()
    if not self.Library or not self.Library.Main then return false end
    self.Library.Main.Visible = not self.Library.Main.Visible
    if self.Library.MiniToggle then self.Library.MiniToggle.Visible = not self.Library.Main.Visible end
    return self.Library.Main.Visible
end
function InterfaceManager:SetScale(value)
    if not self.Library or not self.Library.UIScale then return false end
    local scale = math.clamp(tonumber(value) or 0.92, .75, 1.15)
    self.Library.UIScale.Scale = scale
    return scale
end
function InterfaceManager:BuildInterfaceSection(tab)
    local section = tab:AddSection("INTERFACE SETTINGS")
    local names = {}
    for name in pairs(self.Library and self.Library.Themes or {}) do table.insert(names, name) end
    table.sort(names)
    section:AddDropdown({Key = "theme", Title = "Theme", Values = names, Default = self.Library.ThemeName or "Neon Garden"}, function(value)
        self:ApplyTheme(value)
        self.Library:Notify({Content = "Theme applied: " .. tostring(value), Duration = 1.5})
    end)
    section:AddSlider({Key = "uiScale", Title = "UI scale", Min = .75, Max = 1.15, Step = .01, Default = self.Library.UIScale.Scale}, function(value)
        self:SetScale(value)
    end)
    section:AddToggle({Key = "autoLoad", Title = "Auto load preferences", Default = self.SaveManager and self.SaveManager.AutoLoad or false}, function(value)
        if self.SaveManager then self.SaveManager:SetAutoLoad(value) end
    end)
    section:AddButton({Title = "Toggle interface", Callback = function() self:ToggleUI() end})
    section:AddTitle("Drag the rail or title bar to move. RightControl toggles visibility.")
    return section
end
function InterfaceManager:BindToggle(keyCode)
    self:SetKeybind(keyCode)
    local connection = safe(function()
        return game:GetService("UserInputService").InputBegan:Connect(function(input, processed)
            if not processed and input.KeyCode == self.Keybind then self:ToggleUI() end
        end)
    end)
    if connection then table.insert(self._connections, connection) end
    return connection
end
function InterfaceManager:Destroy()
    for _, connection in ipairs(self._connections) do safe(function() connection:Disconnect() end) end
    self._connections = {}
end
return InterfaceManager
